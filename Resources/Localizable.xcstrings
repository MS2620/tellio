    "Automatic: from what the addon says it offers. Untick what you don't want it searched for, e.g. a sports addon for movies." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático: según lo que el complemento dice ofrecer. Desmarca aquello para lo que no quieras que se busque en él, p. ej. un complemento de deportes para películas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch: nach dem, was das Add-on anbietet. Entferne das Häkchen bei allem, wofür es nicht durchsucht werden soll, z. B. ein Sport-Add-on für Filme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique : d’après ce que l’add-on dit proposer. Décochez ce pour quoi vous ne voulez pas qu’il soit utilisé, par ex. un add-on de sport pour les films."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático: conforme o que o add-on diz oferecer. Desmarque aquilo para que não o quer pesquisado, por ex. um add-on de desporto para filmes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie: według tego, co dodatek oferuje. Odznacz to, do czego nie ma być przeszukiwany, np. dodatek sportowy do filmów."
          }
        }
      }
    },
