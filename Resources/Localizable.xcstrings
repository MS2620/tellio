    "Type at least two letters to search football (every league), Formula 1, rugby, cricket, NFL, NBA, NHL and MLB." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe al menos dos letras para buscar fútbol (todas las ligas), Fórmula 1, rugby, críquet, NFL, NBA, NHL y MLB."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib mindestens zwei Buchstaben ein, um Fußball (alle Ligen), Formel 1, Rugby, Cricket, NFL, NBA, NHL und MLB zu durchsuchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez au moins deux lettres pour chercher dans le football (toutes les ligues), la Formule 1, le rugby, le cricket, la NFL, la NBA, la NHL et la MLB."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva pelo menos duas letras para pesquisar futebol (todas as ligas), Fórmula 1, râguebi, críquete, NFL, NBA, NHL e MLB."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz co najmniej dwie litery, aby przeszukać piłkę nożną (wszystkie ligi), Formułę 1, rugby, krykiet, NFL, NBA, NHL i MLB."
          }
        }
      }
    },
    "Type at least two letters. Programmes are found on channels whose guide has loaded." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe al menos dos letras. Los programas se buscan en los canales cuya guía se ha cargado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib mindestens zwei Buchstaben ein. Sendungen werden auf Sendern gefunden, deren Programm geladen ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez au moins deux lettres. Les programmes sont trouvés sur les chaînes dont le guide est chargé."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva pelo menos duas letras. Os programas são procurados nos canais cujo guia já carregou."
          }
        },
        "pl" : {
