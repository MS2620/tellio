    "When on, subtitles in this language are picked automatically if the video has them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, se eligen automáticamente los subtítulos en este idioma cuando el vídeo los tenga."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn an, werden Untertitel in dieser Sprache automatisch gewählt, sofern das Video sie hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activé, les sous-titres dans cette langue sont choisis automatiquement lorsque la vidéo en propose."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, as legendas neste idioma são escolhidas automaticamente se o vídeo as tiver."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu napisy w tym języku są wybierane automatycznie, jeśli wideo je ma."
          }
        }
      }
    },
    "When streams are sorted by addon order (Settings → Streams), addons higher in the list come first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando los streams se ordenan por complemento (Ajustes → Streams), los complementos más arriba en la lista van primero."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Streams nach Add-on-Reihenfolge sortiert sind (Einstellungen → Streams), kommen Add-ons weiter oben zuerst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand les flux sont triés par ordre des add-ons (Réglages → Flux), les add-ons placés plus haut passent en premier."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando os streams estão ordenados por add-on (Definições → Streams), os add-ons mais acima na lista vêm primeiro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy strumienie są sortowane według kolejności dodatków (Ustawienia → Strumienie), dodatki wyżej na liście są pierwsze."
          }
        }
      }
