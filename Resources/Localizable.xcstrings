    "Switched off: it isn't searched for anything, and keeps its settings for when you switch it back on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: no se busca en él nada y conserva sus ajustes para cuando lo vuelvas a activar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeschaltet: Es wird für nichts durchsucht und behält seine Einstellungen, bis du es wieder einschaltest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : il n’est utilisé pour aucune recherche et garde ses réglages pour quand vous le réactiverez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: não é pesquisado para nada e mantém as definições para quando o voltar a ativar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączony: nie jest przeszukiwany i zachowuje ustawienia do ponownego włączenia."
          }
        }
      }
    },
