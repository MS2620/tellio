    "Signs out of TMDB and your IPTV account and removes every addon. Your favourites, folders and other settings stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la sesión de TMDB y de tu cuenta IPTV y elimina todos los complementos. Tus favoritos, carpetas y demás ajustes se mantienen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet dich bei TMDB und deinem IPTV-Konto ab und entfernt alle Add-ons. Deine Favoriten, Ordner und anderen Einstellungen bleiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous déconnecte de TMDB et de votre compte IPTV et supprime tous les add-ons. Vos favoris, dossiers et autres réglages sont conservés."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina a sessão do TMDB e da sua conta IPTV e remove todos os add-ons. Os seus favoritos, pastas e restantes definições mantêm-se."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wylogowuje z TMDB i konta IPTV oraz usuwa wszystkie dodatki. Ulubione, foldery i pozostałe ustawienia zostają."
          }
        }
