    "Crash reports are on by default. When Tellio crashes, a report is sent the next time it opens." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los informes de fallos están activados por defecto. Si Tellio se cierra inesperadamente, se envía un informe la próxima vez que se abra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absturzberichte sind standardmäßig an. Stürzt Tellio ab, wird beim nächsten Öffnen ein Bericht gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports de plantage sont activés par défaut. Si Tellio plante, un rapport est envoyé à la prochaine ouverture."
