    "The backdrop behind Live TV, Sports, Calendar, Search and Settings. Frosted, Ocean, Sunset, Forest, Aurora and Rosé are soft coloured glows; Dark is plain and easier on the eyes at night; Black is pure black, best on OLED TVs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fondo de TV en directo, Deportes, Calendario, Buscar y Ajustes. Esmerilado, Océano, Atardecer, Bosque, Aurora y Rosé son brillos de color suaves; Oscuro es liso y cansa menos la vista de noche; Negro es negro puro, ideal para teles OLED."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrund von Live-TV, Sport, Kalender, Suche und Einstellungen. Milchglas, Ozean, Sonnenuntergang, Wald, Polarlicht und Rosé sind sanfte Farbverläufe; Dunkel ist schlicht und nachts angenehmer für die Augen; Schwarz ist reines Schwarz, ideal für OLED-Fernseher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’arrière-plan de TV en direct, Sports, Calendrier, Recherche et Réglages. Givré, Océan, Coucher de soleil, Forêt, Aurore et Rosé sont de doux halos colorés ; Sombre est uni et plus reposant la nuit ; Noir est un noir pur, idéal sur les téléviseurs OLED."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fundo da TV em direto, Desporto, Calendário, Pesquisa e Definições. Fosco, Oceano, Pôr do sol, Floresta, Aurora e Rosé são brilhos coloridos suaves; Escuro é liso e cansa menos a vista à noite; Preto é preto puro, ideal em televisores OLED."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tło ekranów TV na żywo, Sport, Kalendarz, Szukaj i Ustawienia. Matowy, Ocean, Zachód słońca, Las, Zorza i Różowy to delikatne kolorowe poświaty; Ciemny jest jednolity i łagodniejszy dla oczu w nocy; Czarny to czysta czerń, najlepsza na telewizorach OLED."
          }
        }
      }
    },
    "The backup server answered %lld." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de copias ha respondido %lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Backup-Server antwortete mit %lld."
