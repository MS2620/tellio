    "Guide data is kept on the Apple TV between refreshes, so the guide opens quickly and your provider is asked less often." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de la guía se guardan en el Apple TV entre actualizaciones, así la guía se abre rápido y se consulta menos al proveedor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Programmdaten bleiben zwischen Aktualisierungen auf dem Apple TV, damit der TV-Guide schnell öffnet und dein Anbieter seltener abgefragt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du guide sont conservées sur l’Apple TV entre deux actualisations : le guide s’ouvre vite et votre fournisseur est moins sollicité."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do guia ficam guardados na Apple TV entre atualizações, para o guia abrir depressa e o fornecedor ser consultado menos vezes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane programu są przechowywane na Apple TV między odświeżeniami, więc program otwiera się szybko, a dostawca jest odpytywany rzadziej."
          }
        }
      }
    },
