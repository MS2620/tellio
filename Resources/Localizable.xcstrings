    "Fixtures cover every competition a team plays in, not just the league you picked it from." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los partidos incluyen todas las competiciones de un equipo, no solo la liga desde la que lo elegiste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele umfassen alle Wettbewerbe eines Teams, nicht nur die Liga, aus der du es gewählt hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les matchs couvrent toutes les compétitions d’une équipe, pas seulement la ligue depuis laquelle vous l’avez choisie."
          }
