    "Some providers only allow certain players. Change this if your login works but channels don't." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos proveedores solo permiten ciertos reproductores. Cámbialo si tu cuenta funciona pero los canales no."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Anbieter erlauben nur bestimmte Player. Ändere das, wenn dein Zugang funktioniert, die Sender aber nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains fournisseurs n’autorisent que certains lecteurs. Changez ceci si vos identifiants fonctionnent mais pas les chaînes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns fornecedores só permitem certos leitores. Altere isto se o acesso funcionar mas os canais não."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektórzy dostawcy dopuszczają tylko wybrane odtwarzacze. Zmień to, jeśli login działa, a kanały nie."
          }
        }
      }
