          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von dir gewählt. Filme und Serien werden nur in den dafür angehakten Add-ons gesucht, ebenso Spiele unter Sport."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisi par vous. Les films et séries ne sont cherchés que dans les add-ons cochés pour eux, de même que les matchs dans Sports."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhido por si. Filmes e séries só são procurados nos add-ons marcados para eles, tal como os jogos em Desporto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane przez Ciebie. Filmy i seriale są szukane tylko w dodatkach zaznaczonych dla nich, tak samo mecze w Sporcie."
          }
        }
      }
