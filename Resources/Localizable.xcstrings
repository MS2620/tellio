    },
    "The Tellio backup service on your VPS (e.g. https://backup.mauroks.co.uk) and the password you set in its .env file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de copias de Tellio en tu VPS (p. ej. https://backup.mauroks.co.uk) y la contraseña que pusiste en su archivo .env."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tellio-Backup-Dienst auf deinem VPS (z. B. https://backup.mauroks.co.uk) und das Passwort aus seiner .env-Datei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service de sauvegarde Tellio sur votre VPS (p. ex. https://backup.mauroks.co.uk) et le mot de passe défini dans son fichier .env."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço de cópias do Tellio no seu VPS (p. ex. https://backup.mauroks.co.uk) e a palavra-passe definida no respetivo ficheiro .env."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa kopii Tellio na twoim VPS (np. https://backup.mauroks.co.uk) i hasło ustawione w jej pliku .env."
          }
        }
      }
    },
    "The upscaler couldn't keep up with this video earlier" : {
      "localizations" : {
        "es" : {
