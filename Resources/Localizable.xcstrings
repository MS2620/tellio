    "Your logins, addons, lists, history and settings here are replaced by the backup's." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus accesos, complementos, listas, historial y ajustes de aquí se sustituyen por los de la copia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zugänge, Add-ons, Listen, Verläufe und Einstellungen hier werden durch die aus dem Backup ersetzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos identifiants, add-ons, listes, historique et réglages sur cet appareil sont remplacés par ceux de la sauvegarde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os acessos, add-ons, listas, histórico e definições deste dispositivo são substituídos pelos da cópia."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje loginy, dodatki, listy, historia i ustawienia na tym urządzeniu zostaną zastąpione danymi z kopii."
          }
        }
      }
    },
    "Your name is used everywhere: Live TV, the guide, search, favourites, the player and Top Shelf. Saved per IPTV account, and kept even when Sort by quality is turned off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nombre se usa en todas partes: TV en directo, la guía, la búsqueda, favoritos, el reproductor y el Top Shelf. Se guarda por cuenta IPTV y se mantiene aunque desactives Ordenar por calidad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Name wird überall verwendet: Live-TV, TV-Guide, Suche, Favoriten, Player und Top Shelf. Er wird pro IPTV-Konto gespeichert und bleibt auch, wenn Nach Qualität sortieren aus ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nom est utilisé partout : TV en direct, le guide, la recherche, les favoris, le lecteur et le Top Shelf. Enregistré par compte IPTV, et conservé même si Trier par qualité est désactivé."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu nome é usado em todo o lado: TV em direto, guia, pesquisa, favoritos, leitor e Top Shelf. Guardado por conta IPTV, e mantido mesmo que desative Ordenar por qualidade."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja nazwa jest używana wszędzie: w TV na żywo, programie TV, wyszukiwaniu, ulubionych, odtwarzaczu i Top Shelf. Zapisywana osobno dla każdego konta IPTV i zachowywana nawet po wyłączeniu Sortuj według jakości."
          }
        }
      }
    },
