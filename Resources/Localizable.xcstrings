    "Hide whole groups or single channels you never watch, and collect channels from any group into folders of your own. Folders appear at the top of Live TV." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta grupos enteros o canales sueltos que nunca ves, y reúne canales de cualquier grupo en tus propias carpetas. Las carpetas aparecen arriba en TV en directo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blende ganze Gruppen oder einzelne Sender aus, die du nie schaust, und sammle Sender aus beliebigen Gruppen in eigenen Ordnern. Ordner erscheinen oben in Live-TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquez des groupes entiers ou des chaînes que vous ne regardez jamais, et rassemblez des chaînes de n’importe quel groupe dans vos propres dossiers. Les dossiers apparaissent en haut de TV en direct."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte grupos inteiros ou canais que nunca vê, e junte canais de qualquer grupo nas suas próprias pastas. As pastas aparecem no topo da TV em direto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryj całe grupy lub pojedyncze kanały, których nigdy nie oglądasz, i zbieraj kanały z dowolnych grup we własnych folderach. Foldery pojawiają się na górze TV na żywo."
          }
        }
      }
    },
