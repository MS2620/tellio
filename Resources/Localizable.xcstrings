        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor de cópias respondeu %lld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer kopii odpowiedział kodem %lld."
          }
        }
      }
    },
    "The calendar lists upcoming episodes of the series in My List. Episodes that have already aired are never shown." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calendario muestra los próximos episodios de las series de Mi lista. Los episodios ya emitidos nunca aparecen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kalender zeigt kommende Folgen der Serien in Meiner Liste. Bereits ausgestrahlte Folgen werden nie angezeigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le calendrier liste les prochains épisodes des séries de Ma liste. Les épisodes déjà diffusés ne sont jamais affichés."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O calendário mostra os próximos episódios das séries de A minha lista. Os episódios já emitidos nunca aparecem."
          }
