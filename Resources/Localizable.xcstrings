    "Either option decodes the audio on the Apple TV, so Dolby Atmos passthrough is off while they're on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas opciones decodifican el audio en el Apple TV, así que el paso directo de Dolby Atmos se desactiva mientras estén activadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Optionen dekodieren den Ton auf dem Apple TV, daher ist die Dolby-Atmos-Durchleitung aus, solange sie an sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces deux options décodent le son sur l’Apple TV ; le passthrough Dolby Atmos est donc désactivé tant qu’elles sont actives."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer uma das opções descodifica o áudio na Apple TV, por isso o passthrough de Dolby Atmos fica desativado enquanto estiverem ativas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obie opcje dekodują dźwięk na Apple TV, więc przekazywanie Dolby Atmos jest wyłączone, gdy są włączone."
          }
        }
