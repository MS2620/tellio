    "Syncs when Tellio opens and every 10 minutes. Scrobbling shows “Watching now” on your Trakt profile and marks things watched at 80%." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sincroniza al abrir Tellio y cada 10 minutos. El scrobble muestra «Viendo ahora» en tu perfil de Trakt y marca como visto al llegar al 80 %."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert beim Öffnen von Tellio und alle 10 Minuten. Scrobbeln zeigt „Schaut gerade“ in deinem Trakt-Profil und markiert Inhalte bei 80 % als gesehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se synchronise à l’ouverture de Tellio puis toutes les 10 minutes. Le scrobbling affiche « En train de regarder » sur votre profil Trakt et marque comme vu à 80 %."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza quando o Tellio abre e a cada 10 minutos. O scrobble mostra “A ver agora” no seu perfil do Trakt e marca como visto aos 80%."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizuje przy uruchomieniu Tellio i co 10 minut. Scrobbling pokazuje „Teraz ogląda” na twoim profilu Trakt i oznacza pozycje jako obejrzane przy 80%."
          }
        }
      }
    },
